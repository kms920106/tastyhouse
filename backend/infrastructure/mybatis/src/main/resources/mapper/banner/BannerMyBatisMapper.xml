<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tastyhouse.infrastructure.mybatis.banner.BannerMyBatisMapper">

    <resultMap id="bannerRow" type="com.tastyhouse.infrastructure.mybatis.banner.BannerRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long" name="id"/>
            <arg column="type" javaType="java.lang.String" name="type"/>
            <arg column="title" javaType="java.lang.String" name="title"/>
            <arg column="image_file_id" javaType="java.lang.Long" name="imageFileId"/>
            <arg column="link_url" javaType="java.lang.String" name="linkUrl"/>
            <arg column="start_date" javaType="java.time.LocalDateTime" name="startDate"/>
            <arg column="end_date" javaType="java.time.LocalDateTime" name="endDate"/>
            <arg column="sort" javaType="java.lang.Integer" name="sort"/>
            <arg column="is_visible" javaType="_boolean" name="visible"/>
            <arg column="is_deleted" javaType="_boolean" name="deleted"/>
            <arg column="created_at" javaType="java.time.LocalDateTime" name="createdAt"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime" name="updatedAt"/>
        </constructor>
    </resultMap>

    <select id="selectActiveById" resultMap="bannerRow">
        SELECT id, type, title, image_file_id, link_url, start_date, end_date, sort,
               is_visible, is_deleted, created_at, updated_at
          FROM BANNER
         WHERE id = #{id}
           AND is_deleted = false
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO BANNER (type, title, image_file_id, link_url, start_date, end_date, sort,
                            is_visible, is_deleted, created_at, updated_at)
        VALUES (#{type}, #{title}, #{imageFileId}, #{linkUrl}, #{startDate}, #{endDate}, #{sort},
                #{visible}, #{deleted}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE BANNER
           SET type = #{type},
               title = #{title},
               image_file_id = #{imageFileId},
               link_url = #{linkUrl},
               start_date = #{startDate},
               end_date = #{endDate},
               sort = #{sort},
               is_visible = #{visible},
               is_deleted = #{deleted},
               updated_at = #{updatedAt}
         WHERE id = #{id}
    </update>

</mapper>
