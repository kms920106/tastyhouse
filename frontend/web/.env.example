# 실제 값은 .env.local 에 설정하세요 (gitignore 처리됨).
# 모든 변수는 src/lib/env.ts 의 Zod 스키마로 검증됩니다.
# E2E_* / UPLOAD_DIR 를 제외한 나머지는 필수이며, 비어 있으면 앱 기동 시 검증에 실패합니다.

# 이 웹앱 자신의 base URL — 소셜 로그인 redirect URI 조립 등에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# web-api (Spring) base URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# 토스 결제
NEXT_PUBLIC_TOSSPAY_CLIENT_KEY=
NEXT_PUBLIC_TOSSPAY_CUSTOMER_KEY=

# 카카오 로그인 / 지도
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_CLIENT=

# 네이버 로그인
NEXT_PUBLIC_NAVER_CLIENT_ID=

# 페이스북 로그인
NEXT_PUBLIC_FACEBOOK_APP_ID=

# 애플 로그인
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Playwright E2E 테스트 로그인 계정. 실제 값은 .env.local 에 설정.
E2E_USERNAME=
E2E_PASSWORD=
# E2E 테스트가 조회할 가게 ID
E2E_TEST_PLACE_ID=1

# 로컬 파일 업로드 저장 경로. 미설정 시 앱 기본값 사용.
# UPLOAD_DIR=
