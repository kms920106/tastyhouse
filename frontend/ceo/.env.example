# ceo-api (Spring) base URL — 공지사항 등 백엔드 연동
# 실제 값은 .env.local 에 설정하세요 (gitignore 처리됨).
NEXT_PUBLIC_API_URL=http://localhost:8080

# 카카오맵 JavaScript 키 (배달지역 지도 편집).
# 미설정 시 지도 UI 는 비활성화되고 검색·트리 편집만 동작한다 — 대시보드가 죽지는 않는다.
NEXT_PUBLIC_KAKAO_MAP_CLIENT=

# 서버 로거(pino) 레벨. 미설정 시 development=debug / production=info.
# 가능한 값: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Playwright E2E 테스트 로그인 계정 (npm run test:e2e). 실제 값은 .env.local 에 설정.
E2E_USERNAME=
E2E_PASSWORD=
